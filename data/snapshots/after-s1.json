  "sessions": [
    {
      "id": "s1",
      "grandparentId": "jaroslav",
      "index": 1,
      "startedAt": "2026-09-29T16:00:00.000Z",
      "endedAt": "2026-09-29T16:08:05.000Z",
      "mode": "voice",
      "status": "done",
      "elConversationId": null,
      "firstMessage": "Ahoj dědo, to jsem já, Tomáš. Moc rád bych si s tebou povídal o tom, jak jsi byl malý. Kde jsi vyrůstal?",
      "continuedThreadId": null
    }
  ],
  "turns": [
    {
      "id": "s1-t01",
      "sessionId": "s1",
      "idx": 1,
      "clientSeq": 1,
      "role": "ai",
      "text": "Ahoj dědo, to jsem já, Tomáš. Moc rád bych si s tebou povídal o tom, jak jsi byl malý. Kde jsi vyrůstal?",
      "at": "2026-09-29T16:00:00.000Z"
    },
    {
      "id": "s1-t02",
      "sessionId": "s1",
      "idx": 2,
      "clientSeq": 2,
      "role": "grandparent",
      "text": "No to ti povím, Tomáši. Narodil jsem se v roce 1946 tady na Kladně. Z okna jsme koukali rovnou na komíny Poldovky, to byla huť, víš. Ty komíny kouřily ve dne v noci a prádlo na šňůře bylo vždycky trochu šedivý.",
      "at": "2026-09-29T16:00:25.000Z"
    },
    {
      "id": "s1-t03",
      "sessionId": "s1",
      "idx": 3,
      "clientSeq": 3,
      "role": "ai",
      "text": "To musel být pohled! A kdo s tebou tenkrát bydlel doma?",
      "at": "2026-09-29T16:00:50.000Z"
    },
    {
      "id": "s1-t04",
      "sessionId": "s1",
      "idx": 4,
      "clientSeq": 4,
      "role": "grandparent",
      "text": "Maminka Anna, táta František a moje mladší sestra Věrka. Ta byla o čtyři roky mladší, pořád se mi věšela na kalhoty. A maminka, ta pekla nejlepší buchty na celým Kladně, s mákem a s povidlama.",
      "at": "2026-09-29T16:01:15.000Z"
    },
    {
      "id": "s1-t05",
      "sessionId": "s1",
      "idx": 5,
      "clientSeq": 5,
      "role": "ai",
      "text": "Buchty s mákem, to zní dobře. Kdy je maminka pekla?",
      "at": "2026-09-29T16:01:40.000Z"
    },
    {
      "id": "s1-t06",
      "sessionId": "s1",
      "idx": 6,
      "clientSeq": 6,
      "role": "grandparent",
      "text": "Každou sobotu. Celej barák voněl. A my s Věrkou jsme vždycky čekali u trouby, kdo dostane tu první, ještě horkou. Maminka nás plácla vařečkou přes prsty, ale nakonec nám dala obě.",
      "at": "2026-09-29T16:02:05.000Z"
    },
    {
      "id": "s1-t07",
      "sessionId": "s1",
      "idx": 7,
      "clientSeq": 7,
      "role": "ai",
      "text": "A co táta? Čím byl?",
      "at": "2026-09-29T16:02:30.000Z"
    },
    {
      "id": "s1-t08",
      "sessionId": "s1",
      "idx": 8,
      "clientSeq": 8,
      "role": "grandparent",
      "text": "Táta František dělal v Poldovce u pece, hutník to byl. Chodil na šichty, i na noční. Když přišel domů, byl celej černej od sazí a maminka mu ohřívala vodu v neckách. Moc nemluvil, ale když mluvil, tak jsme poslouchali.",
      "at": "2026-09-29T16:02:55.000Z"
    },
    {
      "id": "s1-t09",
      "sessionId": "s1",
      "idx": 9,
      "clientSeq": 9,
      "role": "ai",
      "text": "To zní jako přísný, ale hodný táta. Byl jsi na něj pyšný?",
      "at": "2026-09-29T16:03:20.000Z"
    },
    {
      "id": "s1-t10",
      "sessionId": "s1",
      "idx": 10,
      "clientSeq": 10,
      "role": "grandparent",
      "text": "No to víš, že jo. Říkal jsem klukům, že můj táta dělá ocel na celou republiku. A pak jsem tam taky skončil, ale to je jiná kapitola.",
      "at": "2026-09-29T16:03:45.000Z"
    },
    {
      "id": "s1-t11",
      "sessionId": "s1",
      "idx": 11,
      "clientSeq": 11,
      "role": "ai",
      "text": "Tak to si nechám na jindy. A s kým jsi jako kluk nejvíc lítal venku?",
      "at": "2026-09-29T16:04:10.000Z"
    },
    {
      "id": "s1-t12",
      "sessionId": "s1",
      "idx": 12,
      "clientSeq": 12,
      "role": "grandparent",
      "text": "S Pepou Dvořákem. Pepa Dvořák, ten bydlel o dům vedle, byl o dva roky mladší než já. Ale šikovnej kluk, to zase jo.",
      "at": "2026-09-29T16:04:35.000Z"
    },
    {
      "id": "s1-t13",
      "sessionId": "s1",
      "idx": 13,
      "clientSeq": 13,
      "role": "ai",
      "text": "Co jste spolu s Pepou nejradši dělali?",
      "at": "2026-09-29T16:05:00.000Z"
    },
    {
      "id": "s1-t14",
      "sessionId": "s1",
      "idx": 14,
      "clientSeq": 14,
      "role": "grandparent",
      "text": "Fotbal! Na plácku za barákem, branky jsme měli ze dvou kamenů a z kabátů. Hráli jsme do tmy, dokud maminka nezavolala z okna. Pepa chytal, já kopal. Jednou jsem mu napálil míč do nosu, tekla mu krev a stejně chytal dál.",
      "at": "2026-09-29T16:05:25.000Z"
    },
    {
      "id": "s1-t15",
      "sessionId": "s1",
      "idx": 15,
      "clientSeq": 15,
      "role": "ai",
      "text": "Tvrdej brankář! A dělali jste spolu i nějaké lumpárny?",
      "at": "2026-09-29T16:05:50.000Z"
    },
    {
      "id": "s1-t16",
      "sessionId": "s1",
      "idx": 16,
      "clientSeq": 16,
      "role": "grandparent",
      "text": "Jéje, lumpáren bylo. Lezli jsme přes plot k sousedům na třešně, to bylo normální. Ale největší průšvih… to bylo, jak jsme s Pepou v padesátým osmým utekli na pouť do Prahy.",
      "at": "2026-09-29T16:06:15.000Z"
    },
    {
      "id": "s1-t17",
      "sessionId": "s1",
      "idx": 17,
      "clientSeq": 17,
      "role": "ai",
      "text": "Na pouť do Prahy? Sami? Jak jste se tam dostali?",
      "at": "2026-09-29T16:06:40.000Z"
    },
    {
      "id": "s1-t18",
      "sessionId": "s1",
      "idx": 18,
      "clientSeq": 18,
      "role": "grandparent",
      "text": "No to je dlouhý povídání… Sebrali jsme se bez ptaní, nikomu jsme nic neřekli. Ale víš co, Tomáši, už mě z toho povídání bolí v krku. No, to ti řeknu příště.",
      "at": "2026-09-29T16:07:05.000Z"
    },
    {
      "id": "s1-t19",
      "sessionId": "s1",
      "idx": 19,
      "clientSeq": 19,
      "role": "ai",
      "text": "Dobře, dědo, nechám si to na příště a budu se moc těšit. Děkuju ti za dnešek.",
      "at": "2026-09-29T16:07:30.000Z"
    },
    {
      "id": "s1-t20",
      "sessionId": "s1",
      "idx": 20,
      "clientSeq": 20,
      "role": "grandparent",
      "text": "Já taky děkuju. Pozdravuj doma a přijď zas.",
      "at": "2026-09-29T16:07:55.000Z"
    }
  ],
